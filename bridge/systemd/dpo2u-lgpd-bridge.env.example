# /etc/dpo2u-lgpd-bridge.env (600). Trocar o contrato = mudar a 1ª linha e `systemctl restart dpo2u-lgpd-bridge`.
COMPLIANCE_REGISTRY_ADDRESS=817dc7481a314991c57c49ea354315bc3366cff213343faf93dc195ca422c135
# ATENÇÃO (12/11): 817dc748 foi deployado SEM controle de acesso. Com o build atual (owner-only) é preciso
# redeployar (ALLOW_DEPLOY=1 no executor) e trocar o endereço acima.
# Rede da Midnight: preview | preprod | mainnet. Mainnet exige no ambiente do executor CONFIRM_MAINNET=yes,
# BLOCKFROST_PROJECT_ID, DPO2U_OWNER_SECRET e PRIVATE_STATE_PASSWORD (scripts/lib/midnight-v9.ts).
BRIDGE_MIDNIGHT_NETWORK=preview
# 65a6efd6476239e4fc13e8ec8045a3a9037bec055d43ffa442bb32521aac6593 = contrato de TESTE (1ª atestação LGPD, bloco 39830); oficial = 817dc748 (decisão do Fred 09/11 19:43Z)
# Gateway da rede docker mcp-server_default: o container do MCP alcança; em eth0 a porta cai no DROP do VPS-IN.
BRIDGE_HOST=172.29.0.1
BRIDGE_PORT=8788
BRIDGE_TOKEN_FILE=/root/.config/dpo2u/lgpd-bridge.token
BRIDGE_RATE_PER_HOUR=6
LGPD_ATTEST_LOG=/var/log/dpo2u-lgpd-bridge-executor.log
