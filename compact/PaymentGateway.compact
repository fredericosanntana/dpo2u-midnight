pragma language_version >= 0.21.0;
import CompactStandardLibrary;

// ── Access control (mainnet) ──
// Every circuit that writes state is owner-only. The deployer keeps owner_secret private
// (witness, never on chain) and passes owner_commit = owner_commitment(owner_secret) to the
// constructor. Same pattern as TravelRuleGate / PsavPassport.
witness owner_secret(): Bytes<32>;
export ledger owner_commit: Bytes<32>;

constructor(owner_commit_: Bytes<32>) {
  owner_commit = disclose(owner_commit_);
}

export pure circuit owner_commitment(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Bytes<32>>(secret);
}

circuit assert_owner(): [] {
  assert(persistentHash<Bytes<32>>(owner_secret()) == owner_commit, "Only the contract owner can do this");
}

export ledger protocol_treasury: Counter;
// NIGHT the DPO2U treasury has booked as deposited (app-level bookkeeping). This is not how DUST is
// generated: DUST comes from holding NIGHT registered for DUST generation (registerNightUtxosForDustGeneration).
export ledger total_night_deposited: Counter;

export circuit depositToTreasury(amount: Uint<16>): [] {
  assert_owner();
  assert(amount > 0 as Uint<16>, "Deposit must be greater than zero");
  protocol_treasury.increment(disclose(amount));
}

export circuit depositNight(amount: Uint<16>): [] {
  assert_owner();
  assert(amount > 0 as Uint<16>, "NIGHT deposit must be greater than zero");
  total_night_deposited.increment(disclose(amount));
}

export circuit getTreasuryBalance(): Uint<64> {
  return protocol_treasury;
}

export circuit getTotalNightDeposited(): Uint<64> {
  return total_night_deposited;
}

// ── DPO2U Paymaster (increment): non-custodial DUST-generation delegation ──
// A NIGHT holder redirects the DUST their NIGHT generates to the controller's dust
// address (registerNightUtxosForDustGeneration(..., controllerDustAddress) at the wallet
// layer). The NIGHT NEVER leaves the holder's custody and delegation is revocable — this
// ledger only records the delegated capacity so LP revenue shares are auditable on-chain.
export ledger delegated_night: Map<Bytes<32>, Uint<64>>;   // holder_id -> NIGHT delegated (STAR units)
export ledger delegator_count: Counter;                    // distinct holders currently delegating

export circuit registerDustDelegation(holder: Bytes<32>, night_amount: Uint<64>): [] {
  assert_owner();
  assert(night_amount > 0 as Uint<64>, "Delegation must be greater than zero");
  if (!delegated_night.member(disclose(holder))) {
    delegator_count.increment(1);
  }
  delegated_night.insert(disclose(holder), disclose(night_amount));
}

// Revocation (mirrors deregisterFromDustGeneration at the wallet layer). Sets the recorded
// capacity to zero; the holder keeps their NIGHT throughout.
export circuit revokeDustDelegation(holder: Bytes<32>): [] {
  assert_owner();
  assert(delegated_night.member(disclose(holder)), "No active delegation for holder");
  delegated_night.insert(disclose(holder), disclose(0 as Uint<64>));
}

export circuit getDelegatedNight(holder: Bytes<32>): Uint<64> {
  if (delegated_night.member(disclose(holder))) {
    return delegated_night.lookup(disclose(holder));
  } else {
    return 0 as Uint<64>;
  }
}

export circuit getDelegatorCount(): Uint<64> {
  return delegator_count;
}
