pragma language_version >= 0.21.0;
import CompactStandardLibrary;

// TravelRuleGate — FATF R.16 / BCB (Res. 521) Travel Rule gate for a VASP, on Midnight.
//
// PUBLIC state: per-transfer verdict + coarse reason code, a root commitment of each party's
// data, release flag, disclosure-grant metadata (scope/supervisor/expiry/revoked).
// SHIELDED (witness, never on chain): originator/beneficiary identity fields and the amount.
//
// FLOW
//   1. evaluateTransfer(transfer_id): runs the rule over private data, records verdict
//      1=PASS or 2=FAIL (+ reason) publicly, and stores only salted commitments (roots).
//   2. releaseTransfer(transfer_id): reverts unless verdict == PASS. Sets status 3=RELEASED.
//   3. grantDisclosure(...): owner (VASP) registers a scoped, expiring access grant for a
//      supervisor. The data itself travels off-chain, encrypted under a per-grant key; the
//      supervisor checks it against the on-chain roots with the pure circuits below.
//      Scope = bitmask over the 4 fields per party: 1 name, 2 account, 4 document, 8 vasp.
//      Opening one field does not open the others (separate salted commitments).
//
// REASON CODES: 0 none, 1 missing required party info, 2 missing originator id above
//   threshold, 3 counterparty VASP not attested, 4 sanctions screening hit (VASP-attested).
// STATUS: 0 none, 1 PASS, 2 FAIL, 3 RELEASED.

struct Party {
  name_hash: Bytes<32>;
  account_hash: Bytes<32>;
  doc_hash: Bytes<32>;
  vasp_id: Bytes<32>;
  salt: Bytes<32>;
}

witness originator_data(): Party;
witness beneficiary_data(): Party;
witness transfer_amount(): Uint<64>;
// Result of the VASP's off-chain sanctions screening of both parties (NOT proven in-circuit:
// a Set.member on a private hash would publish the hash; an in-circuit non-membership proof is
// a documented follow-up).
witness sanctions_clear(): Boolean;
witness owner_secret(): Bytes<32>;

export ledger owner_commit: Bytes<32>;
export ledger threshold_cents: Uint<64>;
export ledger attested_vasps: Set<Bytes<32>>;
export ledger status: Map<Bytes<32>, Uint<8>>;
export ledger fail_reason: Map<Bytes<32>, Uint<8>>;
export ledger originator_root: Map<Bytes<32>, Bytes<32>>;
export ledger beneficiary_root: Map<Bytes<32>, Bytes<32>>;
export ledger total_pass: Counter;
export ledger total_fail: Counter;
export ledger total_released: Counter;

export ledger grant_transfer: Map<Bytes<32>, Bytes<32>>;
export ledger grant_supervisor: Map<Bytes<32>, Bytes<32>>;
export ledger grant_scope: Map<Bytes<32>, Uint<8>>;
export ledger grant_expires: Map<Bytes<32>, Uint<64>>;
export ledger grant_revoked: Set<Bytes<32>>;
export ledger total_grants: Counter;

constructor(owner_commit_: Bytes<32>, threshold_cents_: Uint<64>) {
  owner_commit = disclose(owner_commit_);
  threshold_cents = disclose(threshold_cents_);
}

// owner_commit = persistentHash(owner_secret) (computed off-chain by the VASP).
export pure circuit owner_commitment(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Bytes<32>>(secret);
}

circuit assert_owner(): [] {
  assert(persistentHash<Bytes<32>>(owner_secret()) == owner_commit, "Only the VASP owner can do this");
}

// Salted commitment of ONE field. label separates the fields so each opens independently.
export pure circuit field_commit(v: Bytes<32>, salt: Bytes<32>, label: Bytes<32>): Bytes<32> {
  const s = persistentHash<Vector<2, Bytes<32>>>([salt, label]);
  return persistentCommit<Bytes<32>>(v, s);
}

// Root over the four field commitments (verifier recomputes it from 1 opening + 3 commitments).
export pure circuit root_of(c0: Bytes<32>, c1: Bytes<32>, c2: Bytes<32>, c3: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([c0, c1, c2, c3]);
}

circuit party_root(p: Party): Bytes<32> {
  return root_of(
    field_commit(p.name_hash, p.salt, pad(32, "name")),
    field_commit(p.account_hash, p.salt, pad(32, "account")),
    field_commit(p.doc_hash, p.salt, pad(32, "document")),
    field_commit(p.vasp_id, p.salt, pad(32, "vasp"))
  );
}

export circuit attestVasp(vasp_id: Bytes<32>): [] {
  assert_owner();
  attested_vasps.insert(disclose(vasp_id));
}

export circuit evaluateTransfer(transfer_id: Bytes<32>): Uint<8> {
  assert(!status.member(disclose(transfer_id)), "Transfer already evaluated");
  const o = originator_data();
  const b = beneficiary_data();
  const amt = transfer_amount();
  const zero = default<Bytes<32>>;

  const complete = o.name_hash != zero && o.account_hash != zero
                && b.name_hash != zero && b.account_hash != zero;
  const above = amt >= threshold_cents;
  const id_ok = !above || o.doc_hash != zero;
  // Counterparty VASP id is deliberately public (regulatory identity, not customer PII).
  const vasp_ok = attested_vasps.member(disclose(b.vasp_id));
  const clean = sanctions_clear();

  const reason: Uint<8> = !complete ? 1 : (!id_ok ? 2 : (!vasp_ok ? 3 : (!clean ? 4 : 0)));
  const pass = reason == 0;

  status.insert(disclose(transfer_id), disclose(pass ? 1 : 2));
  fail_reason.insert(disclose(transfer_id), disclose(reason));
  originator_root.insert(disclose(transfer_id), disclose(party_root(o)));
  beneficiary_root.insert(disclose(transfer_id), disclose(party_root(b)));
  if (disclose(pass)) { total_pass.increment(1); } else { total_fail.increment(1); }
  return disclose(pass ? 1 : 2);
}

export circuit releaseTransfer(transfer_id: Bytes<32>): [] {
  assert_owner();
  assert(status.member(disclose(transfer_id)), "Transfer not evaluated");
  assert(status.lookup(disclose(transfer_id)) == 1, "Travel Rule not satisfied: transfer cannot be released");
  status.insert(disclose(transfer_id), disclose(3 as Uint<8>));
  total_released.increment(1);
}

export circuit grantDisclosure(
  grant_id: Bytes<32>, transfer_id: Bytes<32>, supervisor_id: Bytes<32>,
  scope: Uint<8>, expires_at: Uint<64>
): [] {
  assert_owner();
  assert(status.member(disclose(transfer_id)), "Transfer not evaluated");
  assert(!grant_scope.member(disclose(grant_id)), "Grant id already used");
  assert(scope > 0 as Uint<8>, "Scope must not be empty");
  assert(blockTimeLt(disclose(expires_at)), "Expiry must be in the future");
  grant_transfer.insert(disclose(grant_id), disclose(transfer_id));
  grant_supervisor.insert(disclose(grant_id), disclose(supervisor_id));
  grant_scope.insert(disclose(grant_id), disclose(scope));
  grant_expires.insert(disclose(grant_id), disclose(expires_at));
  total_grants.increment(1);
}

export circuit revokeDisclosure(grant_id: Bytes<32>): [] {
  assert_owner();
  assert(grant_scope.member(disclose(grant_id)), "Unknown grant");
  grant_revoked.insert(disclose(grant_id));
}

export circuit isGrantActive(grant_id: Bytes<32>): Boolean {
  return grant_scope.member(disclose(grant_id))
      && !grant_revoked.member(disclose(grant_id))
      && blockTimeLt(grant_expires.lookup(disclose(grant_id)));
}
