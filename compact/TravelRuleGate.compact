pragma language_version >= 0.28.0;  // JubjubSchnorr, contract-typed ledger fields (compactc 0.36)
import CompactStandardLibrary;

// TravelRuleGate — FATF R.16 / BCB (Res. 521) Travel Rule gate for a VASP, on Midnight.
//
// PUBLIC state: per-transfer verdict + coarse reason code, a root commitment of each party's
// data, release flag, disclosure-grant metadata (scope/supervisor/expiry/revoked).
// SHIELDED (witness, never on chain): originator/beneficiary identity fields and the amount.
//
// LINKED CONTRACTS (v10, cross-contract calls, compactc 0.36 / compact-runtime 0.21):
//   passport: PsavPassport. A counterparty VASP passes the VASP check if the owner attested it
//             (attestVasp) OR its id is a valid PsavPassport (passport.isValid(vasp_id)).
//   registry: ComplianceRegistry. releaseTransfer requires registry.hasAttestation(self_company_id)
//             == 1, i.e. this VASP itself holds a current compliance attestation.
//
// FLOW
//   1. evaluateTransfer(transfer_id, policy_hash): owner (VASP) only. Runs the rule over private
//      data, records verdict 1=PASS or 2=FAIL (+ reason) publicly, the hash of the rule/policy
//      version that produced it (verdict_policy; zero refused), and stores only salted
//      commitments (roots). Owner-gated because the verdict is final and the witnesses (incl.
//      the screening paths) are the VASP's: anyone else knowing a transfer_id could otherwise
//      front-run it with forged data.
//   2. releaseTransfer(transfer_id): reverts unless verdict == PASS and the VASP is attested in
//      the ComplianceRegistry. Sets status 3=RELEASED.
//   3. grantDisclosure(..., purpose_hash): owner (VASP) REQUESTS a scoped, expiring access grant
//      for a supervisor, with the hash of its purpose / legal basis (grant_purpose). The grant is
//      inactive until approveDisclosure(grant_id) by a separate approver (approver_secret, e.g.
//      the DPO): the owner alone cannot open data (four-eyes). The data itself travels off-chain,
//      encrypted under a per-grant key; the supervisor checks it against the on-chain roots with
//      the pure circuits below.
//      Scope = bitmask over the 4 fields per party: 1 name, 2 account, 4 document, 8 vasp.
//      Opening one field does not open the others (separate salted commitments).
//
// SANCTIONS LIST (signed): evaluateTransfer reverts unless the witness sanctions_list is a snapshot
//   signed (Schnorr/Jubjub) by a provider the owner registered (registerSanctionsProvider; one
//   active key per id, re-registering rotates it, revokeSanctionsProvider disables it) and the block
//   time is before its valid_until. The verdict stores verdict_sanctions_root / _provider /
//   _valid_until.
//
// SANCTIONS SCREENING (proven in-circuit, v11-sanctions-nonmembership): the signed list_root is the
//   root of an indexed (sorted) Merkle tree of depth 20 over screening keys, built by the provider
//   (scripts/lib/sanctions-list.ts). Each leaf is (value, next): value is a listed key, next the
//   next larger listed key (0 = none, i.e. +infinity); leaf 0 is (0, smallest key). For each
//   screened identifier the circuit derives its key, takes the leaf the witness names, recomputes
//   the root and checks value <= key < next. That leaf exists for every key, so the prover has no
//   choice: value == key is a proven hit (reason 4), value < key a proven non-membership. Screened
//   identifiers: account_hash and doc_hash of both parties (doc_hash zero = not given, skipped).
//   Names are matched off-chain by the provider when it builds the list (fuzzy matching does not
//   fit a circuit); the list then carries the identifiers of the matched persons.
//   Design credit: the indexed-tree approach was suggested by ProofOrBluff (@realjohnny5i,
//   github.com/bytewizard42i/ProofOrBluff).
//
// REASON CODES: 0 none, 1 missing required party info, 2 missing originator id above
//   threshold, 3 counterparty VASP not attested, 4 sanctions list hit (proven against the signed list).
// STATUS: 0 none, 1 PASS, 2 FAIL, 3 RELEASED.

struct Party {
  name_hash: Bytes<32>;
  account_hash: Bytes<32>;
  doc_hash: Bytes<32>;
  vasp_id: Bytes<32>;
  salt: Bytes<32>;
}

witness originator_data(): Party;
witness beneficiary_data(): Party;
witness transfer_amount(): Uint<64>;
// Indexed-tree path for one screening key (see SANCTIONS SCREENING above). The witness returns the
// leaf with value <= key < next and its 20 siblings; is_right = the current node is a right child.
struct SanctionsLeaf {
  value: Uint<128>;
  next: Uint<128>;
}
struct SanctionsStep {
  sibling: Field;
  is_right: Boolean;
}
struct SanctionsPath {
  leaf: SanctionsLeaf;
  steps: Vector<20, SanctionsStep>;
}
witness sanctions_path(key: Uint<128>): SanctionsPath;

// A sanctions-list snapshot signed by its provider (Schnorr over Jubjub). The provider signs
// sanctions_message(list_root, provider_id, issued_at, valid_until) with jubjubSchnorrSign
// (compact-runtime); the circuit verifies it against the provider's registered key.
struct SanctionsList {
  provider_id: Bytes<32>;
  list_root: Bytes<32>;
  issued_at: Uint<64>;
  valid_until: Uint<64>;
  signature: JubjubSchnorrSignature;
}
witness sanctions_list(): SanctionsList;
witness owner_secret(): Bytes<32>;
witness approver_secret(): Bytes<32>;

// Interfaces of the linked contracts (only the circuits this gate calls).
contract PsavPassport {
  circuit isValid(passport_id: Bytes<32>): Boolean;
}
contract ComplianceRegistry {
  circuit hasAttestation(company_id: Bytes<32>): Uint<8>;
}

export ledger owner_commit: Bytes<32>;
export ledger approver_commit: Bytes<32>;
export ledger passport: PsavPassport;
export ledger registry: ComplianceRegistry;
export ledger self_company_id: Bytes<32>;
export ledger threshold_cents: Uint<64>;
export ledger attested_vasps: Set<Bytes<32>>;
export ledger status: Map<Bytes<32>, Uint<8>>;
export ledger fail_reason: Map<Bytes<32>, Uint<8>>;
export ledger originator_root: Map<Bytes<32>, Bytes<32>>;
export ledger beneficiary_root: Map<Bytes<32>, Bytes<32>>;
export ledger verdict_policy: Map<Bytes<32>, Bytes<32>>;
export ledger verdict_sanctions_root: Map<Bytes<32>, Bytes<32>>;
export ledger verdict_sanctions_provider: Map<Bytes<32>, Bytes<32>>;
export ledger verdict_sanctions_valid_until: Map<Bytes<32>, Uint<64>>;

// Sanctions-list providers: one active key per provider id (re-registering rotates it).
export ledger sanctions_provider_key: Map<Bytes<32>, JubjubPoint>;
export ledger sanctions_provider_revoked: Set<Bytes<32>>;
export ledger total_pass: Counter;
export ledger total_fail: Counter;
export ledger total_released: Counter;

export ledger grant_transfer: Map<Bytes<32>, Bytes<32>>;
export ledger grant_supervisor: Map<Bytes<32>, Bytes<32>>;
export ledger grant_scope: Map<Bytes<32>, Uint<8>>;
export ledger grant_expires: Map<Bytes<32>, Uint<64>>;
export ledger grant_revoked: Set<Bytes<32>>;
export ledger grant_purpose: Map<Bytes<32>, Bytes<32>>;
export ledger grant_approved: Set<Bytes<32>>;
export ledger total_grants: Counter;

constructor(
  owner_commit_: Bytes<32>, threshold_cents_: Uint<64>,
  passport_: PsavPassport, registry_: ComplianceRegistry,
  self_company_id_: Bytes<32>, approver_commit_: Bytes<32>
) {
  assert(approver_commit_ != owner_commit_, "Approver must differ from owner");
  owner_commit = disclose(owner_commit_);
  threshold_cents = disclose(threshold_cents_);
  passport = disclose(passport_);
  registry = disclose(registry_);
  self_company_id = disclose(self_company_id_);
  approver_commit = disclose(approver_commit_);
}

// owner_commit = owner_commitment(owner_secret) (computed off-chain by the VASP with this pure circuit).
export pure circuit owner_commitment(secret: Bytes<32>): Bytes<32> {
  // Domain-tagged per contract: the same secret gives a different owner_commit in each contract.
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "dpo2u/owner/v1"), pad(32, "TravelRuleGate"), secret]);
}

circuit assert_owner(): [] {
  assert(owner_commitment(owner_secret()) == owner_commit, "Only the VASP owner can do this");
}

// approver_commit = approver_commitment(approver_secret), a key held apart from the owner's.
export pure circuit approver_commitment(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "dpo2u/approver/v1"), secret]);
}

circuit assert_approver(): [] {
  assert(approver_commitment(approver_secret()) == approver_commit, "Only the disclosure approver can do this");
}

// Salted commitment of ONE field. label separates the fields so each opens independently.
// To open one field, the VASP hands over the value and that field's BLINDING (field_blinding), never
// the party salt: with the party salt a supervisor could derive every other field's blinding and test
// guesses against the other commitments. field_commit_blinded is what the supervisor recomputes.
export pure circuit field_blinding(salt: Bytes<32>, label: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([salt, label]);
}

export pure circuit field_commit_blinded(v: Bytes<32>, blinding: Bytes<32>): Bytes<32> {
  return persistentCommit<Bytes<32>>(v, blinding);
}

export pure circuit field_commit(v: Bytes<32>, salt: Bytes<32>, label: Bytes<32>): Bytes<32> {
  return field_commit_blinded(v, field_blinding(salt, label));
}

// Root over the four field commitments (verifier recomputes it from 1 opening + 3 commitments).
export pure circuit root_of(c0: Bytes<32>, c1: Bytes<32>, c2: Bytes<32>, c3: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([c0, c1, c2, c3]);
}

circuit party_root(p: Party): Bytes<32> {
  return root_of(
    field_commit(p.name_hash, p.salt, pad(32, "name")),
    field_commit(p.account_hash, p.salt, pad(32, "account")),
    field_commit(p.doc_hash, p.salt, pad(32, "document")),
    field_commit(p.vasp_id, p.salt, pad(32, "vasp"))
  );
}

// The message a provider signs for one list snapshot.
export pure circuit sanctions_message(list_root: Bytes<32>, provider_id: Bytes<32>, issued_at: Uint<64>, valid_until: Uint<64>): Vector<4, Field> {
  return [transientHash<Bytes<32>>(list_root), transientHash<Bytes<32>>(provider_id), issued_at as Field, valid_until as Field];
}

// Registers a provider's public key, or rotates it (the new key replaces the old; a revoked id is reinstated).
export circuit registerSanctionsProvider(provider_id: Bytes<32>, key: JubjubPoint): [] {
  assert_owner();
  sanctions_provider_key.insert(disclose(provider_id), disclose(key));
  if (sanctions_provider_revoked.member(disclose(provider_id))) {
    sanctions_provider_revoked.remove(disclose(provider_id));
  }
}

export circuit revokeSanctionsProvider(provider_id: Bytes<32>): [] {
  assert_owner();
  assert(sanctions_provider_key.member(disclose(provider_id)), "Unknown sanctions provider");
  sanctions_provider_revoked.insert(disclose(provider_id));
}

// Indexed-tree hashing (Poseidon via transientHash). Tags 1 (leaf) and 2 (node) separate the two.
export pure circuit sanctions_leaf_hash(value: Uint<128>, next: Uint<128>): Field {
  return transientHash<Vector<3, Field>>([1 as Field, value as Field, next as Field]);
}
export pure circuit sanctions_node_hash(left: Field, right: Field): Field {
  return transientHash<Vector<3, Field>>([2 as Field, left, right]);
}
// The tree root as the 32 bytes the provider signs (list_root).
export pure circuit sanctions_root_bytes(root: Field): Bytes<32> {
  return root as Bytes<32>;
}
// Screening key of a 32-byte identifier hash: its first 16 bytes, big-endian, as an integer.
export pure circuit screening_key(h: Bytes<32>): Uint<128> {
  const head = slice<16>(h as Vector<32, Uint<8>>, 0);
  return fold((acc: Field, b: Uint<8>): Field => acc * 256 + (b as Field), 0 as Field, head) as Uint<128>;
}
export pure circuit sanctions_path_root(p: SanctionsPath): Field {
  return fold((acc: Field, s: SanctionsStep): Field => s.is_right ? sanctions_node_hash(s.sibling, acc) : sanctions_node_hash(acc, s.sibling),
              sanctions_leaf_hash(p.leaf.value, p.leaf.next), p.steps);
}
// Proves one identifier against the signed list; returns true on a proven hit. A zero hash (field
// not given) is skipped. Reverts if the witness path does not open the signed root or does not
// bracket the key, so the result cannot be chosen by the prover.
circuit screen(h: Bytes<32>, list_root: Bytes<32>): Boolean {
  const key = screening_key(h);
  const p = sanctions_path(key);
  const opens = sanctions_root_bytes(sanctions_path_root(p)) == list_root;
  const brackets = p.leaf.value <= key && (p.leaf.next == 0 || key < p.leaf.next);
  assert(key == 0 || (opens && brackets), "Sanctions path does not prove the identifier against the signed list");
  return key != 0 && p.leaf.value == key;
}

circuit check_sanctions_list(l: SanctionsList): [] {
  const id = disclose(l.provider_id);
  assert(sanctions_provider_key.member(id), "Sanctions provider not registered");
  assert(!sanctions_provider_revoked.member(id), "Sanctions provider revoked");
  assert(l.valid_until > l.issued_at, "Sanctions list validity window is empty");
  assert(blockTimeLt(disclose(l.valid_until)), "Sanctions list expired");
  const ok = jubjubSchnorrVerify<4>(sanctions_message(l.list_root, l.provider_id, l.issued_at, l.valid_until), l.signature, sanctions_provider_key.lookup(id));
  assert(disclose(ok), "Sanctions list signature invalid");
}

export circuit attestVasp(vasp_id: Bytes<32>): [] {
  assert_owner();
  attested_vasps.insert(disclose(vasp_id));
}

export circuit evaluateTransfer(transfer_id: Bytes<32>, policy_hash: Bytes<32>): Uint<8> {
  assert_owner();
  assert(!status.member(disclose(transfer_id)), "Transfer already evaluated");
  assert(policy_hash != default<Bytes<32>>, "Policy hash must not be zero");
  const o = originator_data();
  const b = beneficiary_data();
  const amt = transfer_amount();
  const zero = default<Bytes<32>>;
  // A zero or shared party salt would make the roots guessable or link the two parties.
  assert(o.salt != zero && b.salt != zero, "Party salt must not be zero");
  assert(o.salt != b.salt, "Originator and beneficiary salts must differ");

  const complete = o.name_hash != zero && o.account_hash != zero
                && b.name_hash != zero && b.account_hash != zero;
  const above = amt >= threshold_cents;
  const id_ok = !above || o.doc_hash != zero;
  // Counterparty VASP id is deliberately public (regulatory identity, not customer PII).
  // Attested by this VASP, or holding a valid PsavPassport.
  const vasp_ok = attested_vasps.member(disclose(b.vasp_id)) || passport.isValid(disclose(b.vasp_id));
  const list = sanctions_list();
  check_sanctions_list(list);
  // Four separate proofs (no short-circuit): every given identifier is proven against the list.
  const hit_oa = screen(o.account_hash, list.list_root);
  const hit_od = screen(o.doc_hash, list.list_root);
  const hit_ba = screen(b.account_hash, list.list_root);
  const hit_bd = screen(b.doc_hash, list.list_root);
  const clean = !(hit_oa || hit_od || hit_ba || hit_bd);

  const reason: Uint<8> = !complete ? 1 : (!id_ok ? 2 : (!vasp_ok ? 3 : (!clean ? 4 : 0)));
  const pass = reason == 0;

  status.insert(disclose(transfer_id), disclose(pass ? 1 : 2));
  fail_reason.insert(disclose(transfer_id), disclose(reason));
  originator_root.insert(disclose(transfer_id), disclose(party_root(o)));
  beneficiary_root.insert(disclose(transfer_id), disclose(party_root(b)));
  verdict_policy.insert(disclose(transfer_id), disclose(policy_hash));
  verdict_sanctions_root.insert(disclose(transfer_id), disclose(list.list_root));
  verdict_sanctions_provider.insert(disclose(transfer_id), disclose(list.provider_id));
  verdict_sanctions_valid_until.insert(disclose(transfer_id), disclose(list.valid_until));
  if (disclose(pass)) { total_pass.increment(1); } else { total_fail.increment(1); }
  return disclose(pass ? 1 : 2);
}

export circuit releaseTransfer(transfer_id: Bytes<32>): [] {
  assert_owner();
  assert(status.member(disclose(transfer_id)), "Transfer not evaluated");
  assert(status.lookup(disclose(transfer_id)) == 1, "Travel Rule not satisfied: transfer cannot be released");
  // The screening behind the PASS must still stand at release time (time-of-check / time-of-use).
  assert(blockTimeLt(verdict_sanctions_valid_until.lookup(disclose(transfer_id))), "Sanctions list behind the verdict expired: evaluate again");
  assert(!sanctions_provider_revoked.member(verdict_sanctions_provider.lookup(disclose(transfer_id))), "Sanctions provider revoked since the verdict: evaluate again");
  assert(registry.hasAttestation(self_company_id) == 1, "VASP has no compliance attestation in the registry");
  status.insert(disclose(transfer_id), disclose(3 as Uint<8>));
  total_released.increment(1);
}

export circuit grantDisclosure(
  grant_id: Bytes<32>, transfer_id: Bytes<32>, supervisor_id: Bytes<32>,
  scope: Uint<8>, expires_at: Uint<64>, purpose_hash: Bytes<32>
): [] {
  assert_owner();
  assert(purpose_hash != default<Bytes<32>>, "Purpose hash must not be zero");
  assert(status.member(disclose(transfer_id)), "Transfer not evaluated");
  assert(!grant_scope.member(disclose(grant_id)), "Grant id already used");
  assert(scope > 0 as Uint<8>, "Scope must not be empty");
  assert(blockTimeLt(disclose(expires_at)), "Expiry must be in the future");
  grant_transfer.insert(disclose(grant_id), disclose(transfer_id));
  grant_supervisor.insert(disclose(grant_id), disclose(supervisor_id));
  grant_scope.insert(disclose(grant_id), disclose(scope));
  grant_expires.insert(disclose(grant_id), disclose(expires_at));
  grant_purpose.insert(disclose(grant_id), disclose(purpose_hash));
  total_grants.increment(1);
}

// Second key: the approver (not the owner) activates a requested grant.
export circuit approveDisclosure(grant_id: Bytes<32>): [] {
  assert_approver();
  // Four eyes, in-circuit: the constructor's approver_commit != owner_commit cannot catch the owner
  // registering approver_commitment(owner_secret) (different domains), so the approver's secret must
  // not open the owner commitment.
  assert(owner_commitment(approver_secret()) != owner_commit, "The owner key cannot approve a disclosure");
  assert(grant_scope.member(disclose(grant_id)), "Unknown grant");
  assert(!grant_revoked.member(disclose(grant_id)), "Grant revoked");
  assert(!grant_approved.member(disclose(grant_id)), "Grant already approved");
  grant_approved.insert(disclose(grant_id));
}

export circuit revokeDisclosure(grant_id: Bytes<32>): [] {
  assert_owner();
  assert(grant_scope.member(disclose(grant_id)), "Unknown grant");
  grant_revoked.insert(disclose(grant_id));
}

export circuit isGrantActive(grant_id: Bytes<32>): Boolean {
  return grant_scope.member(disclose(grant_id))
      && grant_approved.member(disclose(grant_id))
      && !grant_revoked.member(disclose(grant_id))
      && blockTimeLt(grant_expires.lookup(disclose(grant_id)));
}
