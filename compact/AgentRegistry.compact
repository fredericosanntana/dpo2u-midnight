pragma language_version >= 0.21.0;
import CompactStandardLibrary;

export ledger agent_count: Counter;
export ledger agent_statuses: Map<Bytes<32>, Uint<8>>;
export ledger agent_roles: Map<Bytes<32>, Bytes<32>>;

export circuit registerAgent(
  agent_did: Bytes<32>,
  role: Bytes<32>
): [] {
  agent_statuses.insert(disclose(agent_did), disclose(1 as Uint<8>));
  agent_roles.insert(disclose(agent_did), disclose(role));
  agent_count.increment(1);
}

export circuit deactivateAgent(
  agent_did: Bytes<32>
): [] {
  assert(agent_statuses.member(disclose(agent_did)), "Agent not registered");
  agent_statuses.insert(disclose(agent_did), disclose(0 as Uint<8>));
}

export circuit isActive(agent_did: Bytes<32>): Uint<8> {
  return agent_statuses.lookup(disclose(agent_did));
}

export circuit getAgentCount(): Uint<64> {
  return agent_count;
}
