# === DPO2U Midnight Agents ===

# --- Midnight Network ---
# Network: "preprod", "preview", or "standalone"
MIDNIGHT_NETWORK=preprod

# 64-char hex wallet seed (leave empty to generate random)
MIDNIGHT_SEED=

# Proof server URL (must be running locally — download from Midnight docs)
PROOF_SERVER_URL=http://127.0.0.1:6300

# --- Network Endpoints (auto-configured per network, override if needed) ---
# Preprod:
#   Indexer:    https://indexer.preprod.midnight.network/api/v3/graphql
#   IndexerWS:  wss://indexer.preprod.midnight.network/api/v3/graphql/ws
#   Node RPC:   https://rpc.preprod.midnight.network
#   Faucet:     https://faucet.preprod.midnight.network/
#
# Preview:
#   Indexer:    https://indexer.preview.midnight.network/api/v3/graphql
#   IndexerWS:  wss://indexer.preview.midnight.network/api/v3/graphql/ws
#   Node RPC:   https://rpc.preview.midnight.network
#   Faucet:     https://faucet.preview.midnight.network/
